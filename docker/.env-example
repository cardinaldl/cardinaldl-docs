# Copy this file to .env and change the values you want.
# docker compose reads .env automatically from this folder.
# Every value here has a default, so you only need to set the ones you care about.

# User and group IDs the container runs as, and that your downloaded files are owned by.
# Set these to your own user so the files on the host are not owned by root.
# On Linux, run `id` to find your values. Defaults are 1000/1000.
PUID=1000
PGID=1000

# Host port for the web UI. Inside the container the app always listens on 4173.
PORT=4173

# Host port for the *arr (Torznab) indexer. Inside the container it always listens on 9117.
ARR_PORT=9117

# Password for the web UI. Set a strong value here before you expose the server.
# If you leave this empty, a random password is created on first start and you will
# not see it, so it is best to set your own.
REMOTE_ACCESS_PASSWORD=

# Turn the *arr (Torznab) integration on or off. Set to true to enable it.
ARR_INTEGRATION_ENABLED=false
